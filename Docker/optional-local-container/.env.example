# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL containerized C++ server — copy to .env.local and fill in.
# This is separate from the native setup.sh flow. Read the README in this folder.
# ─────────────────────────────────────────────────────────────────────────────

# Must match API_KEY in your cloud .env.cloud.
API_KEY=

# Users must supply this when creating an account.
REGISTER_KEY=

# Absolute path on the HOST that gets mounted into the container at /storage.
# This single folder is ALL the container can see.
STORAGE_PATH=

# Port the C++ server is published on (the Cloudflare tunnel points here).
CPP_PORT=8080

# Maximum number of files to index (default: 1000000).
MAX_FILES=1000000
