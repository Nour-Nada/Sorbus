# ─────────────────────────────────────────────────────────────────────────────
# LOCAL MACHINE (Raspberry Pi or home server) — C++ server only
# Copy this file to .env.local and fill in every blank value below.
# Leaving a required value blank is safe: startup is refused on an empty value,
# so you can never accidentally run with a weak placeholder.
# Run with: docker compose -f docker-compose.local.yml --env-file .env.local up
# ─────────────────────────────────────────────────────────────────────────────


# ── Shared API key ────────────────────────────────────────────────────────────
# Must be identical to API_KEY in .env.cloud — this is how Node.js authenticates
# every request it sends to this C++ server. (setup.sh fills this in for you.)
API_KEY=


# ── Signup registration key ───────────────────────────────────────────────────
# Users must supply this key when creating an account.
# Choose something only you share with people you want to allow to sign up.
REGISTER_KEY=


# ── File storage ──────────────────────────────────────────────────────────────
# Absolute path on THIS machine where uploaded files will be stored.
# Linux/Mac example:  /home/yourname/sorbus-storage
STORAGE_PATH=


# ── Optional ──────────────────────────────────────────────────────────────────
# Port the C++ server listens on (default: 8080).
# The Cloudflare tunnel should point to this port.
CPP_PORT=8080

# Maximum number of files the server will index (default: 100000).
MAX_FILES=100000
