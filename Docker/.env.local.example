# ─────────────────────────────────────────────────────────────────────────────
# LOCAL MACHINE (where your files live) — the C++ server
# Copy this file to .env.local and fill in the blanks (or just run setup.sh).
# These variables are read DIRECTLY by the C++ server when you run it natively —
# see the README section "Running the C++ server" for how to load them per-OS.
# ─────────────────────────────────────────────────────────────────────────────


# ── Shared API key ────────────────────────────────────────────────────────────
# Must be identical to API_KEY in .env.cloud — this is how Node.js authenticates
# every request it sends to this C++ server. (setup.sh fills this in for you.)
FILEAPP_API_KEY=


# ── Signup registration key ───────────────────────────────────────────────────
# Users must supply this key when creating an account.
# Choose something only you share with people you want to allow to sign up.
FILEAPP_REGISTER_KEY=


# ── Starting folder ───────────────────────────────────────────────────────────
# Absolute path the app opens on first. This is only the STARTING folder — the
# owner can re-point storage to anywhere allowed (see FILEAPP_ROOT_LIMIT below).
# Linux/Mac example:  /home/yourname/Documents
# Windows example:    C:/Users/yourname/Documents
FILEAPP_FILE_LOCATION=


# ── Root limit (navigation boundary) ──────────────────────────────────────────
# The storage path may only be set INSIDE this folder.
# Leave BLANK for no limit — the owner can browse any folder/drive on this
# machine (the intended "access my whole computer from anywhere" mode).
# Set it to confine access to one branch, e.g. /home/yourname/shared
FILEAPP_ROOT_LIMIT=


# ── Optional ──────────────────────────────────────────────────────────────────
# Maximum number of files the server will index in one folder tree (default: 1000000).
FILEAPP_MAX_FILES=1000000
