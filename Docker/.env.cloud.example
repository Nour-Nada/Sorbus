# ─────────────────────────────────────────────────────────────────────────────
# CLOUD SERVER — Node.js + React only
# Copy this file to .env.cloud and fill in every value marked CHANGE_ME.
# Run with: docker compose -f docker-compose.cloud.yml --env-file .env.cloud up
# ─────────────────────────────────────────────────────────────────────────────


# ── Shared API key ────────────────────────────────────────────────────────────
# Must be identical to API_KEY in .env.local — this is what Node.js sends
# in the key header on every request to the C++ server.
API_KEY=CHANGE_ME


# ── C++ server URL ────────────────────────────────────────────────────────────
# The URL Node.js uses to reach the C++ server on the Pi.
# This will be your Cloudflare tunnel URL once configured.
# Example: https://cpp.yourdomain.com
CPP_SERVER_URL=CHANGE_ME


# ── JWT secrets ───────────────────────────────────────────────────────────────
# Signs the short-lived access token (5 min).
JWT_SECRET=CHANGE_ME

# Signs the long-lived refresh cookie (7 days). Use a different value from JWT_SECRET.
REFRESH_TOKEN_SECRET=CHANGE_ME


# ── CORS origin ───────────────────────────────────────────────────────────────
# The URL users type into their browser to reach Sorbus.
# No trailing slash. Omit the port if it is 80.
# Example: https://sorbus.yourdomain.com
CORS_ORIGIN=CHANGE_ME


# ── Optional ──────────────────────────────────────────────────────────────────
# Port the web UI is served on (default: 80).
FRONTEND_PORT=80
