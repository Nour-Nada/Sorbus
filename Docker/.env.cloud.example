# ─────────────────────────────────────────────────────────────────────────────
# CLOUD SERVER — Node.js + React only
# Copy this file to .env.cloud and fill in every blank value below.
# Leaving a required value blank is safe: startup is refused on an empty value,
# so you can never accidentally run with a weak placeholder.
# Run with: docker compose -f docker-compose.cloud.yml --env-file .env.cloud up
# ─────────────────────────────────────────────────────────────────────────────


# ── Shared API key ────────────────────────────────────────────────────────────
# Must be identical to API_KEY in .env.local — this is what Node.js sends
# in the key header on every request to the C++ server. (setup.sh fills this in.)
API_KEY=


# ── C++ server URL ────────────────────────────────────────────────────────────
# The URL Node.js uses to reach the C++ server at home.
# This will be your Cloudflare tunnel URL once configured.
# Example: https://cpp.yourdomain.com
C_Server_Route=


# ── JWT secrets ───────────────────────────────────────────────────────────────
# Signs the short-lived access token (5 min). (setup.sh fills this in for you.)
JWT_SECRET=

# Signs the long-lived refresh cookie (7 days). Must differ from JWT_SECRET.
# (setup.sh fills this in for you.)
REFRESH_TOKEN_SECRET=


# ── CORS origin ───────────────────────────────────────────────────────────────
# The URL users type into their browser to reach Sorbus.
# No trailing slash. Omit the port if it is 80.
# Example: https://sorbus.yourdomain.com
CORS_ORIGIN=


# ── Optional ──────────────────────────────────────────────────────────────────
# Port the web UI is served on (default: 80).
FRONTEND_PORT=80
